---
// The sun/moon button in the top-right corner of every page (BaseLayout adds it). It scrolls away with the top of the page.
// A click switches between dark and light, remembers the choice, and tells the 3D pictures to recolour.
// Plain HTML and a tiny script: no React, so it costs almost nothing to load.
---

<button class="theme-toggle" type="button" aria-label="Switch to light theme">
  <!-- The sun shows in dark mode (click it to get light), the moon in light mode. CSS picks which one. -->
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  // Runs once per page, after the page loads. The <head> script in BaseLayout already set the right theme.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const root = document.documentElement;

  // Keep the screen-reader label true: it says what a click will do.
  const label = () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  label();

  button.addEventListener('click', () => {
    const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = theme;
    // Saving can fail (e.g. iPhone private browsing). The switch still works, it just isn't remembered.
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    label();
    // The 3D pictures listen for this to read the new colours (src/lib/useThemeColors.ts).
    window.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  });
</script>

<style>
  .theme-toggle {
    /* Top-right of the page, like a header button. Not "fixed": on a phone a fixed button would cover the text. */
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 50;
    width: 2.75rem; /* 44px: big enough for a thumb */
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--surface-border);
    border-radius: 50%;
    background: var(--surface);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--link);
    outline-offset: 2px;
  }

  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='light']) .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>
