---
// The shared frame around every lesson page.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import LessonComplete from '../components/LessonComplete.tsx';
import { chapterOf, getSection, lessonNumber } from '../content/book';

type Lesson = CollectionEntry<'lessons'>;

interface Props {
  lesson: Lesson;
  prev?: Lesson;
  next?: Lesson;
}

const { lesson, prev, next } = Astro.props;
const { title, description, threeBlueOneBrown, mit, tongji, optional } = lesson.data;
const number = lessonNumber(lesson.data);
const section = getSection(lesson.data.section);
const chapter = chapterOf(section.number);

// BASE_URL comes from `base` in astro.config.mjs, e.g. "/Linear-Algebra-BIT-Shehri/" or "/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Lesson) => `${base}/lessons/${l.id}/`;
const label = (l: Lesson) => `${lessonNumber(l.data)} ${l.data.title}`;
---

<BaseLayout title={`${number} ${title} · Visual Linear Algebra`} description={description}>
  <nav class="top"><a href={`${base}/`}>← All lessons</a></nav>

  <main>
    <p class="kicker">
      Chapter {chapter.number}: {chapter.title} · §{section.number} {section.title} · Lesson {number}{optional && ' · Optional (advanced)'}
    </p>
    <h1>{title}</h1>

    <slot />

    <LessonComplete lessonId={lesson.id} client:visible />

    <ul class="sources">
      <li>
        Lay, <cite>Linear Algebra and Its Applications</cite>, §{section.number} {section.title}{section.page !== undefined && `, p. ${section.page}`}
      </li>
      {
        threeBlueOneBrown && (
          <li>
            <a href={threeBlueOneBrown}>3Blue1Brown video</a>
          </li>
        )
      }
      {
        mit && (
          <li>
            <a href={mit}>MIT 18.06 lecture</a>
          </li>
        )
      }
      {tongji && <li>Tongji textbook: {tongji}</li>}
    </ul>
  </main>

  <nav class="prev-next" aria-label="Previous and next lessons">
    {prev ? <a href={href(prev)}>← {label(prev)}</a> : <span />}
    {next && <a class="next" href={href(next)}>{label(next)} →</a>}
  </nav>

  <p class="about"><a href={`${base}/about/`}>About and credits</a></p>
</BaseLayout>

<style>
  .kicker {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 1.5rem 0 0;
  }

  .sources {
    padding-left: 1.25rem;
  }

  /* Stacked on a phone, side by side when there's room. */
  .prev-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .about {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  .next {
    margin-left: auto;
    text-align: right;
  }
</style>
