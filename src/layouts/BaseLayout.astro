---
// The outer frame shared by every page: the <head>, fonts, and global styles.
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
  /** One sentence for search results and link previews. Every page needs one. */
  description: string;
  /** true on the homepage only: its own colours and fonts, always light (the `html.home` block in global.css). */
  home?: boolean;
  /** true for a full-width page: no narrow text column, each section sets its own width. */
  wide?: boolean;
}

const { title, description, home = false, wide = false } = Astro.props;

// BASE_URL comes from `base` in astro.config.mjs, e.g. "/Linear-Algebra-BIT-Shehri/" or "/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en" class:list={{ home }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={['page', { wide }]}>
      <slot />
    </div>
  </body>
</html>
