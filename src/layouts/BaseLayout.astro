---
// The outer frame shared by every page: the <head>, fonts, and global styles.
import '@fontsource-variable/inter';
import '../styles/theme.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  /** One sentence for search results and link previews. Every page needs one. */
  description: string;
  /** true on the homepage only: its own fonts and layout (the `html.home` block in global.css). */
  home?: boolean;
  /** true for a full-width page: no narrow text column, each section sets its own width. */
  wide?: boolean;
}

const { title, description, home = false, wide = false } = Astro.props;

// BASE_URL comes from `base` in astro.config.mjs, e.g. "/Linear-Algebra-BIT-Shehri/" or "/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Dark is the default, written into the page itself so the first paint is already dark. -->
<html lang="en" data-theme="dark" class:list={{ home }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Runs before anything is drawn: if the visitor chose light, switch now, so there's no dark flash.
         Saved choices can't be read in some private modes, so a failure just keeps dark. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <ThemeToggle />
    <div class:list={['page', { wide }]}>
      <slot />
    </div>
  </body>
</html>
