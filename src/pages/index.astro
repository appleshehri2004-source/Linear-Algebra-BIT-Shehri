---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedLessons, moduleName } from '../content/modules';

const lessons = await getSortedLessons();

// Group the lessons by module number, keeping reading order: [[1, [...]], [2, [...]]].
const modules = [...new Set(lessons.map((l) => l.data.module))].map(
  (module) => [module, lessons.filter((l) => l.data.module === module)] as const,
);

// BASE_URL is "/Linear-Algebra-BIT-Shehri/" (set by `base` in astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Visual Linear Algebra">
  <h1>Visual Linear Algebra</h1>
  <p>See the maths move. Pick a lesson to start.</p>

  {
    modules.map(([module, moduleLessons]) => (
      <section>
        <h2>
          Module {module}: {moduleName(module)}
        </h2>
        <ul class="lessons">
          {moduleLessons.map((lesson) => (
            <li>
              <a href={`${base}/lessons/${lesson.id}/`}>
                <span class="number">
                  {lesson.data.module}.{lesson.data.order}
                </span>
                {lesson.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .lessons {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lessons a {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem 0; /* tall enough to tap easily on a phone */
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .number {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
  }
</style>
