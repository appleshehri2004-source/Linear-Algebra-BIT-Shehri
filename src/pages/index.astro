---
import { getCollection } from 'astro:content';

// All lessons, in the order set by each lesson's `order` field.
const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.order - b.data.order,
);

// BASE_URL is "/" today and "/linear-algebra-site/" once deployed to GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>Visual Linear Algebra</title>
  </head>
  <body>
    <h1>Visual Linear Algebra</h1>
    <p>Pick a lesson to start.</p>
    <ol>
      {
        lessons.map((lesson) => (
          <li>
            <a href={`${base}/lessons/${lesson.id}/`}>{lesson.data.title}</a>
            : {lesson.data.description}
          </li>
        ))
      }
    </ol>
  </body>
</html>

<style>
  body {
    /* System fonts only: nothing is loaded from the internet. */
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem;
  }
</style>
