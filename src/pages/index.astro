---
// The homepage (docs/homepage-brief.md). At the top: the 3D world behind the page and its 5 stations
// (Phase 2: the camera flies through them; they're still empty). Below them, the rest of the first homepage,
// which later phases trim (Phase 8).
// The serif heading font, installed from npm and bundled with the site (no Google Fonts). Only the homepage loads it.
import '@fontsource-variable/source-serif-4';
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import BigIdeas from '../components/BigIdeas.tsx';
import ChapterCardPicture from '../components/ChapterCardPicture.astro';
import Load3D from '../components/Load3D.tsx';
import Still3D from '../components/Still3D.astro';
import { HaloFilter } from '../components/HomeHalo.tsx';
import { TestShapeSymbols } from '../components/TestShape.tsx';
import LessonList, { type ChapterLinks } from '../components/LessonList.tsx';
import SvdShowcase from '../components/SvdShowcase.tsx';
import StationRail from '../components/world/StationRail.astro';
import World from '../components/world/World.tsx';
import { book, lessonNumber } from '../content/book';
import {
  CARD_3D_MATRIX,
  CARD_3D_PRESETS,
  STATIONS,
  cardStories,
  chapterIdeas,
  chapterSummaries,
  lessonCountText,
} from '../content/home';
import '../styles/world.css';
import { exerciseIds, getSortedLessons } from '../content/modules';

const lessons = await getSortedLessons();

// BASE_URL comes from `base` in astro.config.mjs, e.g. "/Linear-Algebra-BIT-Shehri/" or "/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessonHref = (id: string) => `${base}/lessons/${id}/`;

// The chapter cards: chapters with active sections, with their lesson counts.
const cards = chapterSummaries(lessons);

// Follow the book: each chapter with its active sections, and each section with its lessons,
// in the plain shape LessonList wants. Archived sections are left out; chapters with nothing active too.
const chapters: ChapterLinks[] = book
  .map((chapter) => ({
    number: chapter.number,
    title: chapter.title,
    sections: chapter.sections
      .filter((s) => s.status === 'active')
      .map((s) => ({
        number: s.number,
        title: s.title,
        page: s.page,
        lessons: lessons
          .filter((l) => l.data.section === s.number)
          .map((l) => ({
            id: l.id,
            href: lessonHref(l.id),
            number: lessonNumber(l.data),
            title: l.data.title,
            exerciseIds: exerciseIds(l),
            optional: l.data.optional ?? false,
          })),
      })),
  }))
  .filter((chapter) => chapter.sections.length > 0);

// The steps every lesson goes through, in the order they appear on a lesson page.
const lessonSteps = [
  { name: 'Question', text: 'A puzzle to think about before any formulas.' },
  { name: 'Play', text: 'Drag, stretch and flip until you see the answer.' },
  { name: 'Numbers', text: 'The same picture, written as numbers that update as you move.' },
  { name: 'Explain', text: 'Why it works, in plain words and then in symbols.' },
  { name: 'Predict', text: 'Guess what happens next, then reveal it.' },
  { name: 'Practice', text: 'Short exercises that check themselves.' },
  { name: 'Go deeper', text: 'The matching 3Blue1Brown video and MIT lecture.' },
  { name: 'Do in your book', text: 'Exercises to do on paper from the textbook.' },
];

// The optional extras: lessons that go beyond the plane.
const extras = [
  { id: '1-9-4-3d', name: 'Matrices in 3D', text: 'The same ideas with three axes: a cube turns, stretches and shears.' },
  { id: '6-1-4-cross-product', name: 'The cross product', text: 'Two arrows in space give a third, at right angles to both.' },
  { id: '6-1-3-duality', name: 'Duality', text: 'Why a dot product is secretly a matrix that squashes the plane onto a line.' },
].filter((e) => lessons.some((l) => l.id === e.id));

const firstLesson = lessons[0];
---

<BaseLayout
  home
  wide
  title="Visual Linear Algebra"
  description={`Learn linear algebra by moving things: drag vectors, stretch grids and watch matrices act, in ${lessons.length} interactive lessons that follow Lay's textbook.`}
>
  <!-- The BIT logo (and the plain F), defined once. The hero, the chapter cards and the SVD showcase point at it
       with <use>, so its 66 paths are in the page only once. The arrows' paper halo filter is defined here too. -->
  <svg class="shape-symbols" width="0" height="0" aria-hidden="true" focusable="false">
    <TestShapeSymbols />
    <defs><HaloFilter /></defs>
  </svg>

  <!-- 1. The world and its 5 stations. #home-root holds them, and the 3D canvas listens for the mouse on it. -->
  <div id="home-root" class="world-root">
    <!-- Fixed behind everything: the poster (a still of station 1, shown at once) and the live canvas over it.
         aria-hidden: it's decoration for screen readers; the stations below carry the words. -->
    <div class="world-layer" aria-hidden="true">
      <div class="world-poster"></div>
      <World client:only="react" />
    </div>

    <p class="site-name">Visual Linear Algebra · BIT</p>
    <h1 class="visually-hidden">Visual Linear Algebra: see linear algebra move</h1>
    <StationRail />

    {
      STATIONS.map((station, k) => (
        <section class="station" id={station.id} aria-label={station.name}>
          {k === 0 && (
            <p class="scroll-hint" aria-hidden="true">
              Scroll
            </p>
          )}
          {k === STATIONS.length - 1 && (
            <p class="station-actions">
              <a class="button" href={lessonHref(firstLesson.id)}>Start chapter 1</a>
              <a class="text-link" href="#chapters">Browse chapters</a>
            </p>
          )}
          <!-- Where the live readout goes in Phases 3–7. For now: the station's number and name. -->
          <p class="station-label">
            <span class="station-number">{String(k + 1).padStart(2, '0')}</span> {station.name}
          </p>
        </section>
      ))
    }
  </div>

  <main>
    <!-- 2. Chapter map -->
    <section class="band" id="chapters" aria-labelledby="chapters-title">
      <div class="wrap">
        <h2 id="chapters-title">The chapters</h2>
        <p class="section-lead">The course follows the book's order. Pick a chapter to see its lessons.</p>
        <ol class="cards chapter-cards">
          {
            cards.map((c) => (
              <li>
                <a class="card" href={`#chapter-${c.number}`}>
                  <ChapterCardPicture story={cardStories.find((s) => s.chapter === c.number)!} />
                  <span class="card-kicker">Chapter {c.number}</span>
                  <span class="card-title">{c.title}</span>
                  <span class="card-text">{chapterIdeas[c.number]}</span>
                  <span class="card-count">{lessonCountText(c.lessonCount)}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- All lessons: every lesson with saved progress. The chapter cards jump into this list. -->
    <section class="band sunken" id="lessons" aria-labelledby="lessons-title">
      <div class="wrap narrow">
        <h2 id="lessons-title">All lessons</h2>
        <!-- client:visible, like every island: it shows saved ticks as soon as it scrolls into view. -->
        <LessonList chapters={chapters} client:visible />
      </div>
    </section>

    <!-- 3. SVD showcase -->
    <section class="band reveal" aria-labelledby="svd-title">
      <div class="wrap">
        <h2 id="svd-title">Every matrix is a rotation, a stretch, and a rotation</h2>
        <p class="section-lead">
          The singular value decomposition, A = UΣVᵀ, splits any matrix into three simple moves. Step through them and
          watch the shape turn, stretch along the axes, and turn again.
        </p>
        <!-- client:visible with a 200px margin: it starts loading just before it scrolls into view. Until then
             the built page holds an empty square of the same size, so nothing below it moves. -->
        <SvdShowcase client:visible={{ rootMargin: '200px' }} />
      </div>
    </section>

    <!-- 4. Four big ideas -->
    <section class="band sunken reveal" aria-labelledby="ideas-title">
      <div class="wrap">
        <h2 id="ideas-title">Four big ideas</h2>
        <!-- The four texts and the pinned picture that plays each one. client:visible: it starts when the section
             scrolls into view; the texts are in the built page before that, for search engines and screen readers. -->
        <BigIdeas client:visible />
      </div>
    </section>

    <!-- 5. How a lesson works -->
    <section class="band reveal" aria-labelledby="steps-title">
      <div class="wrap">
        <h2 id="steps-title">How a lesson works</h2>
        <ol class="steps">
          {
            lessonSteps.map((step) => (
              <li>
                <span class="step-name">{step.name}</span>
                <span class="step-text">{step.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 6. Optional extras -->
    <section class="band sunken reveal" aria-labelledby="extras-title">
      <div class="wrap">
        <h2 id="extras-title">Optional extras</h2>
        <p class="section-lead">Lessons that go beyond the plane, for when you want more.</p>
        <ul class="cards extra-cards">
          {
            extras.map((e) =>
              e.id === '1-9-4-3d' ? (
                // The 3D card isn't one big link, because it holds a button: its title is the link instead.
                // Its still picture is drawn at build time; three.js only downloads after "Load 3D" is tapped.
                <li class="extra-3d">
                  <div class="card card-3d">
                    <div class="card-3d-text">
                      <a class="card-title" href={lessonHref(e.id)}>
                        {e.name}
                      </a>
                      <span class="card-text">{e.text}</span>
                    </div>
                    <Load3D client:visible matrix={CARD_3D_MATRIX} presets={CARD_3D_PRESETS}>
                      <Still3D />
                    </Load3D>
                  </div>
                </li>
              ) : (
                <li>
                  <a class="card" href={lessonHref(e.id)}>
                    <span class="card-title">{e.name}</span>
                    <span class="card-text">{e.text}</span>
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </div>
    </section>
  </main>

  <!-- 7. Footer -->
  <footer class="band site-footer">
    <div class="wrap">
      <p>
        The course follows the chapter and section order of <cite>Linear Algebra and Its Applications</cite> by David C.
        Lay, Steven R. Lay and Judi J. McDonald. The visual approach is inspired by 3Blue1Brown's <a href="https://www.3blue1brown.com/topics/linear-algebra"><cite>Essence of Linear Algebra</cite></a>, and lessons link to Gilbert Strang's <a href="https://ocw.mit.edu/courses/18-06-linear-algebra-spring-2010/">MIT 18.06</a> lectures. All text,
        pictures and exercises on this site are our own.
      </p>
      <p>BIT logo used with permission of Beijing Institute of Technology.</p>
      <p class="footer-links">
        <a href={`${base}/about/`}>About and credits</a>
        <a href="https://github.com/appleshehri2004-source/Linear-Algebra-BIT-Shehri">Source code on GitHub</a>
      </p>
    </div>
  </footer>
</BaseLayout>

<script>
  import { STATIONS } from '../content/home';
  import { onWorldChange, scrollToStation, startWorldScroll, world } from '../lib/worldScroll';

  // Start the scroll store for the 5 station sections (the 3D world reads it), and Lenis on computers.
  startWorldScroll(STATIONS.map((s) => document.getElementById(s.id)!));

  // The station rail: light the dot of the nearest station, and glide to a station on click.
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>('.station-rail a')];
  const rail = document.querySelector<HTMLElement>('.station-rail')!;
  const hint = document.querySelector<HTMLElement>('.scroll-hint');
  let current = -1;
  const updateRail = () => {
    const nearest = Math.round(world.s);
    if (nearest !== current) {
      current = nearest;
      railLinks.forEach((a, k) => (k === nearest ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
    }
    // The rail goes once the world fades out; hidden (not just see-through) so Tab skips it too.
    rail.classList.toggle('gone', world.out > 0.5);
    hint?.classList.toggle('gone', world.s > 0.05);
  };
  updateRail();
  onWorldChange(updateRail);
  railLinks.forEach((a, k) =>
    a.addEventListener('click', (e) => {
      // Our own glide goes to the station's middle (where the camera holds still). Stop the click here, or
      // Lenis's link handling (on the whole window) would also glide, to the section's top.
      e.preventDefault();
      e.stopPropagation();
      scrollToStation(k);
    }),
  );

  // On a touch screen a tap opens the chapter straight away, so the card's little animation would never be seen.
  // There, each card plays once when it is mostly on screen instead (the "in-view" class; the CSS is in home.ts).
  if (window.matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in-view');
          watcher.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('.chapter-cards .card').forEach((card) => watcher.observe(card));
  }
</script>
