---
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonList, { type ModuleLinks } from '../components/LessonList.tsx';
import { exerciseIds, getSortedLessons, moduleName } from '../content/modules';

const lessons = await getSortedLessons();

// BASE_URL comes from `base` in astro.config.mjs, e.g. "/Linear-Algebra-BIT-Shehri/" or "/".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Group the lessons by module number, keeping reading order, in the plain shape LessonList wants.
const modules: ModuleLinks[] = [...new Set(lessons.map((l) => l.data.module))].map((module) => ({
  module,
  name: moduleName(module),
  lessons: lessons
    .filter((l) => l.data.module === module)
    .map((l) => ({
      id: l.id,
      href: `${base}/lessons/${l.id}/`,
      number: `${l.data.module}.${l.data.order}`,
      title: l.data.title,
      exerciseIds: exerciseIds(l),
      optional: l.data.optional ?? false,
    })),
}));
---

<BaseLayout
  title="Visual Linear Algebra"
  description="Learn linear algebra by moving things: drag vectors, stretch grids and watch matrices act, in 40 interactive lessons."
>
  <h1>Visual Linear Algebra</h1>
  <p>See the maths move. Pick a lesson to start.</p>

  <!-- client:visible, like every island: the list is at the top, so it still shows saved ticks as soon as the page opens. -->
  <LessonList modules={modules} client:visible />

  <p class="footer-links"><a href={`${base}/about/`}>About and credits</a></p>
</BaseLayout>

<style>
  .footer-links {
    margin-top: 3rem;
    color: var(--muted);
  }
</style>
