---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// All lessons, in the order set by each lesson's `order` field.
const lessons = (await getCollection('lessons')).sort(
  (a, b) => a.data.order - b.data.order,
);

// BASE_URL is "/Linear-Algebra-BIT-Shehri/" (set by `base` in astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Visual Linear Algebra">
  <h1>Visual Linear Algebra</h1>
  <p>Pick a lesson to start.</p>
  <ol>
    {
      lessons.map((lesson) => (
        <li>
          <a href={`${base}/lessons/${lesson.id}/`}>{lesson.data.title}</a>
          : {lesson.data.description}
        </li>
      ))
    }
  </ol>
</BaseLayout>
